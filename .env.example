NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Example only: replace with the same unique random secret in both apps before use.
# Never use this placeholder as a production secret.
AUTH_SESSION_SECRET=example-only-replace-with-a-unique-random-secret-before-use

# Microsoft Entra External ID (server-side Web app registration)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=example-only-not-a-real-secret
ENTRA_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
ENTRA_OIDC_METADATA_URL=https://example.ciamlogin.com/example.onmicrosoft.com/v2.0/.well-known/openid-configuration?appid=00000000-0000-0000-0000-000000000000

# Azure Table Storage for enquiry records. Production should use the App Service
# managed identity; set the account key only for local development if needed.
AZURE_STORAGE_ACCOUNT_NAME=replacewithyouraccount
AZURE_STORAGE_TABLE_NAME=Enquiries
# On an Azure Linux VM, opt into its system-assigned managed identity instead.
# AZURE_USE_VM_MANAGED_IDENTITY=true
# For a user-assigned VM identity, set its client ID as well.
# AZURE_VM_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_STORAGE_ACCOUNT_KEY=example-only-not-a-real-key
